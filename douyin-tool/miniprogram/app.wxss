/* 全局样式与设计令牌 */
@import "styles/icons.wxss";

page {
  /* 主色 */
  --brand: #4E6EF2;
  --brand-light: #6B87FF;
  --brand-deep: #3D5BEF;
  --brand-2: #8A6BFF;
  --brand-soft: rgba(78, 110, 242, 0.08);
  --brand-grad: linear-gradient(135deg, #4E6EF2 0%, #7B5CFF 100%);
  --hero-grad: linear-gradient(160deg, #3D5BEF 0%, #5B7CFA 46%, #8A6BFF 100%);

  /* 中性色 */
  --bg: #F4F5F9;
  --card: #FFFFFF;
  --text: #15171C;
  --text-2: #4A4F5C;
  --sub: #8A8F9C;
  --sub-2: #B0B5C1;
  --line: #EEF0F5;
  --fill: #F6F7FA;

  /* 语义色 */
  --ok: #0AA06E;
  --ok-soft: rgba(10, 160, 110, 0.1);
  --warn: #E0523D;
  --warn-soft: rgba(224, 82, 61, 0.08);
  --gold: #F0A020;
  --gold-soft: #FFF8E8;

  /* 圆角与阴影 */
  --r-lg: 32rpx;
  --r-md: 24rpx;
  --r-sm: 16rpx;
  --shadow-1: 0 4rpx 16rpx rgba(23, 26, 31, 0.04);
  --shadow-2: 0 16rpx 40rpx rgba(23, 26, 31, 0.08);
  --shadow-brand: 0 14rpx 30rpx rgba(78, 110, 242, 0.26);

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, image {
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-1);
}

.card-flat {
  background: var(--card);
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
}

/* 按钮 */
.btn {
  height: 96rpx;
  border-radius: var(--r-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.btn-primary {
  color: #fff;
  background: var(--brand-grad);
  box-shadow: var(--shadow-brand);
}

.btn-ghost {
  color: var(--text);
  background: var(--fill);
}

.btn[disabled] {
  opacity: 0.5;
}

/* 小胶囊标签 */
.pill {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--brand);
  background: var(--brand-soft);
}

/* 文字 */
.muted {
  color: var(--sub);
  font-size: 24rpx;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #EEF0F5 25%, #F7F8FB 37%, #EEF0F5 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease infinite;
  border-radius: 12rpx;
}

@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 旋转 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
