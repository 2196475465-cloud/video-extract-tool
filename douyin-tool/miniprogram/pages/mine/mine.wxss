.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--bg);
}

.nav {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(23, 26, 31, 0.06);
}

.nav-back .ic {
  width: 34rpx;
  height: 34rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.nav-space {
  width: 68rpx;
}

/* 额度卡 */
.quota-card {
  position: relative;
  margin: 20rpx 28rpx 0;
  padding: 36rpx;
  border-radius: 36rpx;
  background: var(--hero-grad);
  color: #fff;
  overflow: hidden;
  box-shadow: 0 20rpx 44rpx rgba(78, 110, 242, 0.26);
}

.q-glow {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  right: -180rpx;
  top: -200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.26) 0%, rgba(255, 255, 255, 0) 70%);
}

.q-top {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.q-num {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -3rpx;
}

.q-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  opacity: 0.82;
  letter-spacing: 0.5rpx;
}

.q-btn {
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.q-btn:active {
  opacity: 0.92;
}

.q-btn.off {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.85);
  font-weight: 400;
}

.q-play {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.q-bar {
  position: relative;
  height: 8rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.26);
  margin: 28rpx 0 16rpx;
  overflow: hidden;
}

.q-bar-in {
  height: 100%;
  border-radius: 99rpx;
  background: #fff;
  transition: width 0.3s ease;
}

.q-foot {
  position: relative;
  font-size: 21rpx;
  opacity: 0.8;
  display: flex;
  align-items: center;
}

.q-dot {
  margin: 0 10rpx;
  opacity: 0.6;
}

/* 菜单 */
.menu {
  margin: 24rpx 28rpx 0;
  padding: 6rpx 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  position: relative;
}

.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 108rpx;
  right: 28rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--line);
}

.menu-item:active {
  background: #FAFBFD;
}

.mi-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.mi-icon .ic {
  width: 36rpx;
  height: 36rpx;
}

.mi-text {
  flex: 1;
  font-size: 28rpx;
}

.mi-extra {
  font-size: 23rpx;
  color: var(--sub);
  margin-right: 6rpx;
}

.mi-arrow {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.7;
}

/* 关于 */
.about {
  margin-top: 44rpx;
  text-align: center;
}

.brand-line {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #A9AEBA;
}

.tiny {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.about-line {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #B6BBC7;
}
