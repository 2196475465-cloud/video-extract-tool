.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.nav {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--fill);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back .ic {
  width: 34rpx;
  height: 34rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.nav-action,
.nav-space {
  width: 64rpx;
  font-size: 24rpx;
  color: var(--brand);
  text-align: right;
}

.nav-space {
  width: 64rpx;
}

.list {
  padding: 24rpx 32rpx 0;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item:active {
  background: #FAFBFD;
}

.cover {
  width: 132rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background: #EDEFF4;
  flex: none;
}

.body {
  flex: 1;
  margin-left: 22rpx;
  overflow: hidden;
}

.title {
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 500;
}

.sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--sub);
}

.dot {
  margin: 0 10rpx;
  color: #D5D9E2;
}

.time {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #B4B9C6;
}

.arrow {
  width: 26rpx;
  height: 26rpx;
  margin-left: 8rpx;
  opacity: 0.7;
}

.empty {
  padding-top: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 44rpx;
  background: #EAEDF6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon .ic {
  width: 64rpx;
  height: 64rpx;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.empty .btn {
  margin-top: 40rpx;
  width: 300rpx;
  height: 84rpx;
  font-size: 28rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #B4B9C6;
  margin-top: 10rpx;
}
