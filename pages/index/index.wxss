.page {
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* ---------------- 顶部渐变 ---------------- */
.hero {
  position: relative;
  padding: 0 36rpx 136rpx;
  background: var(--hero-grad);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  overflow: hidden;
}

.hero-light {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-light.l1 {
  width: 520rpx;
  height: 520rpx;
  top: -240rpx;
  right: -160rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 68%);
}

.hero-light.l2 {
  width: 420rpx;
  height: 420rpx;
  top: 40rpx;
  right: 150rpx;
  background: radial-gradient(circle, rgba(170, 205, 255, 0.3) 0%, rgba(170, 205, 255, 0) 70%);
}

.hero-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image: linear-gradient(rgba(255, 255, 255, 0.07) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
  opacity: 0.5;
  pointer-events: none;
}

.hero-top {
  position: relative;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
}

.logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.logo .ic {
  width: 32rpx;
  height: 32rpx;
}

.brand-name {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.nav-actions {
  display: flex;
}

.nav-btn + .nav-btn {
  margin-left: 12rpx;
}

.nav-btn {
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  color: #fff;
  font-size: 23rpx;
}

.nav-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.nav-ic {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.hero-title {
  position: relative;
  margin-top: 56rpx;
  color: #fff;
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -1.5rpx;
}

.hero-title .hl {
  color: #FFD887;
}

.hero-sub {
  position: relative;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  letter-spacing: 0.3rpx;
}

.hero-tags {
  position: relative;
  display: flex;
  margin-top: 30rpx;
}

.tag {
  margin-right: 12rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.92);
  font-size: 21rpx;
  line-height: 42rpx;
}

/* ---------------- 输入卡片 ---------------- */
.panel {
  position: relative;
  z-index: 2;
  margin: -100rpx 28rpx 0;
  padding: 32rpx;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(30, 40, 90, 0.1);
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.panel-title {
  font-size: 27rpx;
  font-weight: 600;
}

.panel-hint {
  font-size: 21rpx;
  color: var(--sub-2);
}

.paste-box {
  background: var(--fill);
  border-radius: 24rpx;
  padding: 24rpx 24rpx 18rpx;
  border: 1rpx solid #EEF0F6;
}

.paste-input {
  width: 100%;
  min-height: 150rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text);
}

.ph {
  color: #B6BBC7;
  font-size: 27rpx;
}

.paste-tools {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E5E8F0;
}

.tool {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(23, 26, 31, 0.05);
  display: flex;
  align-items: center;
  color: var(--brand);
  font-size: 23rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.tool:active {
  background: #F0F3FF;
}

.tool-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

.tool.ghost {
  background: transparent;
  box-shadow: none;
  color: var(--sub);
  padding: 0 10rpx;
}

.counter {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--sub-2);
}

.main-btn {
  margin-top: 26rpx;
  height: 100rpx;
  border-radius: 26rpx;
  font-size: 32rpx;
}

.main-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
}

.spinner {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #fff;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

.quota-line {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  font-size: 23rpx;
  color: var(--sub);
}

.quota-ic {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.quota-line .strong {
  color: var(--brand);
  font-weight: 600;
  padding: 0 4rpx;
}

.warn-text {
  color: var(--warn);
}

.quota-link {
  margin-left: auto;
  color: var(--brand);
  font-weight: 500;
}

/* ---------------- 公告 ---------------- */
.notice {
  margin: 24rpx 32rpx 0;
  padding: 18rpx 22rpx;
  background: var(--gold-soft);
  border-radius: 18rpx;
  display: flex;
  align-items: flex-start;
}

.notice-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--gold);
  margin: 8rpx 16rpx 0 0;
  flex: none;
}

.notice-text {
  font-size: 23rpx;
  color: #8A6212;
  line-height: 1.6;
}

/* ---------------- 三步 ---------------- */
.steps {
  margin: 24rpx 28rpx 0;
  padding: 34rpx 12rpx 30rpx;
  display: flex;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 6rpx;
}

.step-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.step-ic {
  width: 38rpx;
  height: 38rpx;
}

.step-title {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.step-desc {
  font-size: 20rpx;
  color: var(--sub);
  line-height: 1.5;
  margin-top: 6rpx;
}

/* ---------------- 最近提取 ---------------- */
.recent {
  margin-top: 36rpx;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx 20rpx;
}

.recent-title {
  font-size: 27rpx;
  font-weight: 600;
}

.recent-more {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: var(--sub);
}

.more-ic {
  width: 22rpx;
  height: 22rpx;
  margin-left: 2rpx;
}

.recent-scroll {
  white-space: nowrap;
  padding: 0 28rpx;
}

.recent-item {
  display: inline-block;
  width: 180rpx;
  margin-right: 18rpx;
  vertical-align: top;
}

.cover-wrap {
  position: relative;
  width: 180rpx;
  height: 240rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #EDEFF4;
}

.recent-cover {
  width: 180rpx;
  height: 240rpx;
  display: block;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 100%);
}

.recent-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 19rpx;
  z-index: 2;
}

.recent-dur {
  position: absolute;
  bottom: 10rpx;
  right: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 19rpx;
  z-index: 2;
}

.recent-name {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------------- 页脚 ---------------- */
.footer {
  padding: 36rpx 36rpx 24rpx;
  text-align: center;
}

.footer-line {
  font-size: 21rpx;
  color: #A9AEBA;
}

.footer-link {
  font-size: 22rpx;
  color: var(--brand);
  margin-top: 10rpx;
}

/* ---------------- 遮罩 ---------------- */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 17, 22, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.mask-card {
  width: 460rpx;
  padding: 48rpx 32rpx 40rpx;
  background: #fff;
  border-radius: 30rpx;
  text-align: center;
}

.mask-ring {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  border: 6rpx solid #E6EAF7;
  border-top-color: var(--brand);
  animation: spin 0.9s linear infinite;
}

.mask-text {
  font-size: 30rpx;
  font-weight: 500;
}

.mask-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--sub);
}
